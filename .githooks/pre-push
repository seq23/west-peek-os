#!/bin/sh
# Pre-push: the typecheck ONLY (owner, 22 Nov 2026: "WHY THE FUCK ARE WE STILL DUPLICATING CHECKS?!").
# CI runs every test and scan once, and re-runs last time's failures first, so nothing runs twice.
cd "$(git rev-parse --show-toplevel)" || exit 1
[ -d node_modules ] || { echo "pre-push: no node_modules here, so the typecheck cannot run: run npm ci first"; exit 1; }
npm run -s typecheck || { echo "pre-push BLOCKED: the typecheck failed (above)."; exit 1; }

{
  "name": "west-peek-os",
  "private": true,
  "version": "0.25.0",
  "description": "West Peek OS — governed institutional operating system (P0-P12 substrate, P13-P25 operating product).",
  "type": "module",
  "scripts": {
    "backup:local": "node scripts/backup/backup.mjs",
    "build": "vite build",
    "deploy:production": "node scripts/deploy/production.mjs",
    "dev": "npm run build && wrangler dev",
    "e2e": "node scripts/e2e/prepare-local.mjs && CI=true npx wrangler d1 migrations apply WP_OS_DB --local && node scripts/e2e/prepare-local.mjs --verify-only && playwright test",
    "migrate:local": "wrangler d1 migrations apply WP_OS_DB --local",
    "prices:refresh": "node scripts/prices/refresh.mjs",
    "restore:local": "node scripts/backup/restore.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run test",
    "validate:ai-boundary": "node scripts/validate/no-direct-provider-calls.mjs && node scripts/validate/no-direct-provider-calls.mjs --self-test && node scripts/seed/generate-ai-employee-seed.mjs --check",
    "validate:angles": "node scripts/validate/one-topic-several-angles.mjs && node scripts/validate/one-topic-several-angles.mjs --self-test",
    "validate:authority": "node scripts/validate/no-unauthorized-effects.mjs && node scripts/validate/no-unauthorized-effects.mjs --self-test && node scripts/seed/generate-machine-seed.mjs --check",
    "validate:deliverable-kinds": "node scripts/validate/a-kind-the-database-accepts.mjs && node scripts/validate/a-kind-the-database-accepts.mjs --self-test",
    "validate:scans-read-code": "node scripts/validate/a-scan-reads-code-not-prose.mjs && node scripts/validate/a-scan-reads-code-not-prose.mjs --self-test",
    "validate:blocks": "node scripts/validate/a-block-can-be-cleared.mjs && node scripts/validate/a-block-can-be-cleared.mjs --self-test",
    "validate:brief-ends-stated": "node scripts/validate/a-brief-always-ends-stated.mjs && node scripts/validate/a-brief-always-ends-stated.mjs --self-test",
    "validate:brief-arrives": "node scripts/validate/a-brief-that-fails-says-so.mjs && node scripts/validate/a-brief-that-fails-says-so.mjs --self-test",
    "validate:brand": "node scripts/validate/west-peek-brand-system.mjs && node scripts/validate/west-peek-brand-system.mjs --self-test",
    "validate:chaining": "node scripts/validate/a-lane-that-cannot-serve-must-chain.mjs && node scripts/validate/a-lane-that-cannot-serve-must-chain.mjs --self-test",
    "validate:call-classification": "node scripts/validate/every-call-is-classified.mjs && node scripts/validate/every-call-is-classified.mjs --self-test",
    "validate:css-classes": "node scripts/validate/css-classes.mjs",
    "validate:heading-scale": "node scripts/validate/heading-scale-applies.mjs && node scripts/validate/heading-scale-applies.mjs --self-test",
    "validate:css-variables": "node scripts/validate/css-variables.mjs",
    "validate:deck-cadence": "node scripts/validate/a-rare-lane-is-checked-daily.mjs && node scripts/validate/a-rare-lane-is-checked-daily.mjs --self-test",
    "validate:deck-decision": "node scripts/validate/deck-current-requires-a-decision.mjs && node scripts/validate/deck-current-requires-a-decision.mjs --self-test",
    "validate:quiet-is-not-a-fault": "node scripts/validate/quiet-is-not-a-fault.mjs && node scripts/validate/quiet-is-not-a-fault.mjs --self-test",
    "validate:design-tokens": "node scripts/validate/design-tokens.mjs && node scripts/validate/design-tokens.mjs --self-test",
    "validate:employee-sender": "node scripts/validate/employee-sender-domain.mjs && node scripts/validate/employee-sender-domain.mjs --self-test",
    "validate:employee-lane": "node scripts/validate/every-employee-takes-the-lane.mjs && node scripts/validate/every-employee-takes-the-lane.mjs --self-test",
    "validate:env-vars": "node scripts/validate/env-vars-are-registered.mjs && node scripts/validate/env-vars-are-registered.mjs --self-test",
    "validate:free-lanes": "node scripts/validate/free-lanes-cannot-see-confidential.mjs && node scripts/validate/free-lanes-cannot-see-confidential.mjs --self-test",
    "validate:instructions": "node scripts/validate/an-instruction-reaches-a-model.mjs && node scripts/validate/an-instruction-reaches-a-model.mjs --self-test",
    "validate:mail-authority": "node scripts/validate/mail-assignment-needs-authentication.mjs && node scripts/validate/mail-assignment-needs-authentication.mjs --self-test",
    "validate:network-boundary": "node scripts/validate/no-cross-repo-coupling.mjs && node scripts/validate/no-cross-repo-coupling.mjs --self-test",
    "validate:one-lever": "node scripts/validate/one-lever-not-four.mjs && node scripts/validate/one-lever-not-four.mjs --self-test",
    "validate:partner-email": "node scripts/validate/partner-email-boundary.mjs && node scripts/validate/partner-email-boundary.mjs --self-test",
    "validate:partners": "node scripts/validate/one-partner-registry.mjs && node scripts/validate/one-partner-registry.mjs --self-test",
    "validate:record-scales": "node scripts/validate/the-record-scales.mjs && node scripts/validate/the-record-scales.mjs --self-test",
    "validate:preview": "node scripts/validate/preview-sends-nowhere.mjs && node scripts/validate/preview-sends-nowhere.mjs --self-test",
    "validate:preview-lane": "node scripts/validate/a-preview-guards-the-send.mjs && node scripts/validate/a-preview-guards-the-send.mjs --self-test",
    "validate:prices": "node scripts/prices/refresh.mjs --offline-check && node scripts/prices/refresh.mjs --self-test",
    "validate:spent-attempts": "node scripts/validate/spent-attempts-are-terminal.mjs && node scripts/validate/spent-attempts-are-terminal.mjs --self-test",
    "validate:sql": "node scripts/validate/sql-against-schema.mjs && node scripts/validate/sql-against-schema.mjs --self-test",
    "validate:steer-waits": "node scripts/validate/a-steer-waits-for-its-month.mjs && node scripts/validate/a-steer-waits-for-its-month.mjs --self-test",
    "validate:stopped-cards": "node scripts/validate/a-stopped-card-says-why.mjs && node scripts/validate/a-stopped-card-says-why.mjs --self-test",
    "validate:value-shapes": "node scripts/validate/value-shapes.mjs && node scripts/validate/value-shapes.mjs --self-test",
    "vault:doctor": "node scripts/vault/vault.mjs doctor",
    "vault:import": "node scripts/vault/vault.mjs import",
    "vault:init": "node scripts/vault/vault.mjs init",
    "vault:remove": "node scripts/vault/vault.mjs remove",
    "vault:run": "node scripts/vault/vault.mjs run --",
    "vault:set": "node scripts/vault/vault.mjs set",
    "vault:status": "node scripts/vault/vault.mjs status",
    "vault:sync:cloudflare": "node scripts/vault/vault.mjs sync:cloudflare",
    "validate:seats": "node scripts/validate/two-seats-and-one-ladder.mjs && node scripts/validate/two-seats-and-one-ladder.mjs --self-test && node scripts/claimer/subscription-seat-claimer.mjs --self-test",
    "validate:stopped-runs": "node scripts/validate/what-stopped-is-counted-once.mjs && node scripts/validate/what-stopped-is-counted-once.mjs --self-test",
    "validate:chain-budget": "node scripts/validate/a-run-may-not-spend-the-morning-looking.mjs && node scripts/validate/a-run-may-not-spend-the-morning-looking.mjs --self-test",
    "validate:green-means-something": "node scripts/validate/a-green-run-means-something.mjs && node scripts/validate/a-green-run-means-something.mjs --self-test",
    "validate:companies-in-pipeline": "node scripts/validate/every-company-is-in-the-pipeline.mjs && node scripts/validate/every-company-is-in-the-pipeline.mjs --self-test",
    "validate:weekly-review-archived": "node scripts/validate/an-archived-lane-stays-archived.mjs && node scripts/validate/an-archived-lane-stays-archived.mjs --self-test",
    "validate:portfolio": "node scripts/validate/the-portfolio-shows-what-the-firm-owns.mjs && node scripts/validate/the-portfolio-shows-what-the-firm-owns.mjs --self-test",
    "validate:calendar-sync": "node scripts/validate/a-calendar-meeting-exists-once.mjs && node scripts/validate/a-calendar-meeting-exists-once.mjs --self-test",
    "validate:meet-ingest": "node scripts/validate/a-meet-call-that-ended-is-read.mjs && node scripts/validate/a-meet-call-that-ended-is-read.mjs --self-test"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "miniflare": "^4.20251014.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "wrangler": "^4.131.2"
  }
}
